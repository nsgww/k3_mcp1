[Unit]
Description=Qwen3 30B A3B llama.cpp OpenAI Server
After=network.target

[Service]
Type=simple
User=root123
Group=root123
WorkingDirectory=/var/lib/llm-sdk/models/llm
ExecStart=/usr/bin/llama-server \
  -m /var/lib/llm-sdk/models/llm/Qwen3-30B-A3B-Instruct-2507-Q4_0.gguf \
  -t 8 \
  --host 127.0.0.1 \
  --port 8080 \
  --ctx-size 15360 \
  --n-gpu-layers 0 \
  --batch-size 512 \
  --metrics \
  --no-mmap \
  --jinja
Restart=on-failure
RestartSec=5
TimeoutStartSec=600
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llama-server

[Install]
WantedBy=multi-user.target
